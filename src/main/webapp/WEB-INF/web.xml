<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>DescargarCertificadoServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.DescargarCertificadoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RutaServlet</servlet-name>
        <url-pattern>/RutaServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CertificadoServlet</servlet-name>
        <url-pattern>/CertificadoServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DescargarCertificadoServlet</servlet-name>
        <url-pattern>/DescargarCertificadoServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <!-- Mapeo para RegistroServlet -->
    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.RegistroServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RutaServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.RutaServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CertificadoServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.CertificadoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/RegistroServlet</url-pattern>
    </servlet-mapping>
    <!-- Mapeo para LoginServlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <!-- Mapeo para HomeServlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/HomeServlet</url-pattern>
    </servlet-mapping>
    <!-- Mapeo para LogoutServlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>
    <!-- Mapeo para LeccionServlet -->
    <servlet>
        <servlet-name>LeccionServlet</servlet-name>
        <servlet-class>com.mycompany.horizon.controlador.LeccionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LeccionServlet</servlet-name>
        <url-pattern>/LeccionServlet</url-pattern>
    </servlet-mapping>
    <!-- Filtro de Autenticación (Actualizado con las rutas exactas) -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.mycompany.horizon.controlador.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/HomeServlet</url-pattern>
        <url-pattern>/LeccionServlet</url-pattern>
        <url-pattern>/EvaluacionServlet</url-pattern>
        <url-pattern>/vistas/dashboard.jsp</url-pattern>
        <url-pattern>/vistas/cursos/*</url-pattern>
        <url-pattern>/vistas/rutas/*</url-pattern>
        <url-pattern>/vistas/certificados/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
</web-app>
